# Copy this file to .env.local for local development, and add the same
# variable in your Vercel project's Settings → Environment Variables for
# production.

# Resend API key used by app/api/contact/route.ts to email contact form
# submissions. Get one at https://resend.com/api-keys — until this is set,
# submissions are logged to the server console instead of emailed, so the
# form still works end-to-end in local dev.
RESEND_API_KEY=
